# Puerto interno (nginx hace de proxy). Elegí uno que no use ldp-backend.
PORT=4100

# Podés usar el mismo Mongo de la web, pero con OTRA base de datos (robot)
MONGO_URI=mongodb://127.0.0.1:27017/robot

# Tokens: generalos con  openssl rand -hex 32
ADMIN_TOKEN=cambiar-token-del-panel
DEVICE_TOKEN=cambiar-token-del-robot

# Orígenes permitidos para el panel (separados por coma)
CORS_ORIGIN=http://localhost:5173,https://robot.tudominio.com

# IA
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=300
HISTORY_LIMIT=12

# Voz (opcional hasta tener el hardware). "none" o "openai"
VOICE_PROVIDER=none
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
VOICE_LANGUAGE=es
INPUT_SAMPLE_RATE=16000
MAX_LISTEN_SECONDS=30
