# Entorno: prod o dev. En el VPS el script de deploy arma el .env de cada entorno solo.
APP_ENV=prod

# Puerto del host donde queda el panel (docker compose). El proxy del VPS apunta acá.
PANEL_PORT=8090

# Con docker compose dejalo vacío: usa el contenedor robot-mongo.
# En desarrollo local: mongodb://127.0.0.1:27017/robot
MONGO_URI=

# Tokens: generalos con  openssl rand -hex 32
ADMIN_TOKEN=cambiar-token-del-panel
DEVICE_TOKEN=cambiar-token-del-robot

# Orígenes permitidos para el panel (separados por coma)
CORS_ORIGIN=http://localhost:5173,https://robot.malestraface.com

# IA
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_TOKENS=300
HISTORY_LIMIT=12

# Voz (opcional hasta tener el hardware). "none" o "openai"
# none | openai (pago) | local (gratis: Whisper + Piper en el VPS; ver README "Voz gratis")
VOICE_PROVIDER=none
# Para la voz local además: COMPOSE_PROFILES=voz y elegir modelos
# COMPOSE_PROFILES=voz
# STT_MODEL=Systran/faster-whisper-small
# TTS_MODEL=speaches-ai/piper-es_AR-daniela-high
# TTS_VOICE=daniela
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
VOICE_LANGUAGE=es
INPUT_SAMPLE_RATE=16000
MAX_LISTEN_SECONDS=30
